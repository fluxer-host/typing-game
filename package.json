{
  "name": "typing-fluxer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node script/build.mjs",
    "dev": "node script/dev.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test",
    "db:migrate": "wrangler d1 migrations apply fluxer-typing-game --local",
    "test:live": "node --experimental-websocket script/live-race.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.42.0"
  }
}

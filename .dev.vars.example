# Copy to .dev.vars for local `wrangler dev`. This file is not deployed.
# SESSION_SECRET is not a Fluxer credential. Generate one with:
#   openssl rand -base64 32
# Paste that output below. Do not reuse this placeholder.
SESSION_SECRET=replace-with-a-long-random-string
ALLOW_DEV_LOGIN=true

# Production OAuth. Leave FLUXER_REDIRECT_URI unset so the callback follows
# the host in the browser. Set it only to force one callback.
# FLUXER_CLIENT_ID=
# FLUXER_CLIENT_SECRET=
# FLUXER_REDIRECT_URI=https://typing.fluxer.my/auth/callback

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typing-fluxer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "RACE", "class_name": "Race" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "Race"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typing-game",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FLUXER_API": "https://api.fluxer.app",
    "MEDIA_BASE": "https://fluxerusercontent.com",
    "STATIC_CDN": "https://fluxerstatic.com"
  }
}
